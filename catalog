<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Catalog | V5 Medical LTD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-md py-4">
        <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
            <a href="/" class="flex items-center gap-3">
                <img src="https://raw.githubusercontent.com/alden888/v5md/main/images/logo/v5logo.png" 
                     class="h-12" alt="V5 Medical">
                <div>
                    <div class="font-bold text-xl text-blue-900">V5 Medical LTD</div>
                    <div class="text-xs text-blue-600">Global Medical Supplier</div>
                </div>
            </a>
            <div class="flex gap-8 items-center">
                <a href="/" class="font-medium text-gray-600 hover:text-blue-900">Home</a>
                <a href="catalog" class="font-medium text-blue-900 border-b-2 border-blue-900">Products</a>
                <a href="about" class="font-medium text-gray-600 hover:text-blue-900">About</a>
                <a href="contact" class="font-medium text-gray-600 hover:text-blue-900">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="py-16 bg-gradient-to-r from-blue-600 to-cyan-500 text-white">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Product Catalog</h1>
            <p class="text-xl opacity-90">ISO 13485, CE & FDA Certified Medical Products</p>
        </div>
    </section>

    <!-- Products -->
    <section class="max-w-7xl mx-auto px-4 py-12">
        <div id="products-container" class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <!-- Products will be loaded here -->
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-gray-400 mb-4">© 2025 V5 Medical LTD. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // 简单的产品数据 - 内嵌在页面中
        const PRODUCTS_LIST = [
            {
                id: 'pga-absorbable-suture',
                name: 'PGA Absorbable Suture',
                category: 'Surgical Sutures',
                short: 'Monofilament PGA suture with excellent tensile strength',
                price: 'Contact for Price',
                availability: 'In Stock',
                image: 'https://raw.githubusercontent.com/alden888/v5md/main/images/products/surgical-sutures/pga-absorbable-suture.jpg'
            },
            {
                id: 'pgla-absorbable-suture',
                name: 'PGLA Absorbable Suture',
                category: 'Surgical Sutures',
                short: 'Braided PGLA suture with excellent handling',
                price: 'Contact for Price',
                availability: 'In Stock',
                image: 'https://raw.githubusercontent.com/alden888/v5md/main/images/products/surgical-sutures/pgla-braided-suture.jpg'
            },
            {
                id: 'chromic-catgut',
                name: 'Chromic Catgut',
                category: 'Surgical Sutures',
                short: 'Natural chromic catgut for ophthalmic surgery',
                price: 'Contact for Price',
                availability: 'In Stock',
                image: 'https://raw.githubusercontent.com/alden888/v5md/main/images/products/surgical-sutures/chromic-catgut.jpg'
            },
            {
                id: 'surgical-blades',
                name: 'Surgical Blades',
                category: 'Surgical Instruments',
                short: 'Sterile surgical blades in various sizes',
                price: 'Contact for Price',
                availability: 'In Stock',
                image: 'https://raw.githubusercontent.com/alden888/v5md/main/images/products/surgical-instruments/surgical-blades.jpg'
            },
            {
                id: 'gauze-swabs',
                name: 'Gauze Swabs',
                category: 'Gauze Dressings',
                short: 'Sterile cotton gauze swabs',
                price: 'Contact for Price',
                availability: 'In Stock',
                image: 'https://raw.githubusercontent.com/alden888/v5md/main/images/products/gauze-dressings/gauze-swabs.jpg'
            },
            {
                id: 'surgical-face-masks',
                name: 'Surgical Face Masks',
                category: 'Protective Equipment',
                short: '3-ply surgical masks with ear loops',
                price: 'Contact for Price',
                availability: 'In Stock',
                image: 'https://raw.githubusercontent.com/alden888/v5md/main/images/products/protective-equipment/surgical-face-masks.jpg'
            },
            {
                id: 'disposable-syringes',
                name: 'Disposable Syringes',
                category: 'Injection & Infusion',
                short: 'Sterile medical syringes',
                price: 'Contact for Price',
                availability: 'In Stock',
                image: 'https://raw.githubusercontent.com/alden888/v5md/main/images/products/injection-infusion/disposable-syringes.jpg'
            }
        ];

        // 渲染产品
        function renderProducts() {
            const container = document.getElementById('products-container');
            
            container.innerHTML = PRODUCTS_LIST.map(product => `
                <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition overflow-hidden">
                    <div class="relative">
                        <img src="${product.image}" 
                             alt="${product.name}"
                             class="w-full h-48 object-cover">
                        <div class="absolute top-2 right-2 bg-green-500 text-white text-xs px-3 py-1 rounded-full font-semibold">
                            ${product.availability}
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-lg mb-2">${product.name}</h3>
                        <p class="text-gray-600 text-sm mb-3">${product.short}</p>
                        <div class="mb-4">
                            <span class="text-gray-500 text-xs uppercase">${product.category}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-900">${product.price}</span>
                            <a href="product-detail?id=${product.id}" 
                               class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // 页面加载时渲染
        document.addEventListener('DOMContentLoaded', renderProducts);
    </script>
</body>
</html>