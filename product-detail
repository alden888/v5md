    <script>
        // 获取URL中的产品ID
        function getProductId() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('id') || urlParams.get('product');
        }

        // 渲染产品详情
        function renderProduct(product) {
            if (!product) {
                document.getElementById('app').innerHTML = `
                    <div class="text-center py-20">
                        <i class="fas fa-exclamation-triangle text-red-500 text-6xl mb-4"></i>
                        <h2 class="text-2xl font-bold mb-2">Product Not Found</h2>
                        <p class="text-gray-600 mb-6">The requested product was not found in our database.</p>
                        <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg">
                            Return Home
                        </a>
                    </div>
                `;
                return;
            }

            // 构建产品页面
            document.getElementById('app').innerHTML = `
                <!-- Navigation -->
                <nav class="bg-white shadow-sm py-4">
                    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
                        <a href="/" class="flex items-center gap-3">
                            <img src="https://raw.githubusercontent.com/alden888/v5md/main/images/logo/v5logo.png" 
                                 class="h-10" alt="V5 Medical">
                            <span class="font-bold text-blue-900">V5 Medical LTD</span>
                        </a>
                        <div class="flex gap-6">
                            <a href="/" class="text-gray-600 hover:text-blue-600">Home</a>
                            <a href="catalog" class="text-blue-600 font-medium">← Back to Catalog</a>
                        </div>
                    </div>
                </nav>

                <!-- Product Content -->
                <div class="max-w-7xl mx-auto px-4 py-12">
                    <div class="grid lg:grid-cols-2 gap-12">
                        <!-- Product Image -->
                        <div>
                            <div class="bg-white rounded-xl shadow-md p-6 mb-6">
                                <img src="${product.image || 'https://via.placeholder.com/600x400?text=Product+Image'}" 
                                     alt="${product.name}"
                                     class="w-full h-auto rounded-lg">
                            </div>
                            
                            <!-- Certifications -->
                            <div class="bg-white rounded-xl shadow-md p-6">
                                <h3 class="font-bold text-lg mb-4">Certifications</h3>
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="bg-blue-50 p-4 rounded-lg text-center">
                                        <img src="https://raw.githubusercontent.com/alden888/v5md/main/images/quality/ce-mark.png" 
                                             class="w-16 h-16 mx-auto mb-2 object-contain">
                                        <span class="text-xs font-semibold">CE Mark</span>
                                    </div>
                                    <div class="bg-green-50 p-4 rounded-lg text-center">
                                        <img src="https://raw.githubusercontent.com/alden888/v5md/main/images/quality/iso13485-2016.jpg" 
                                             class="w-16 h-16 mx-auto mb-2 object-contain">
                                        <span class="text-xs font-semibold">ISO 13485</span>
                                    </div>
                                    <div class="bg-red-50 p-4 rounded-lg text-center">
                                        <img src="https://raw.githubusercontent.com/alden888/v5md/main/images/quality/fda.jpg" 
                                             class="w-16 h-16 mx-auto mb-2 object-contain">
                                        <span class="text-xs font-semibold">FDA</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Product Details -->
                        <div>
                            <h1 class="text-3xl font-bold text-gray-900 mb-4">${product.name}</h1>
                            
                            <div class="flex items-center gap-3 mb-6">
                                <span class="bg-green-100 text-green-800 text-sm px-3 py-1 rounded-full font-medium">
                                    ${product.availability}
                                </span>
                                <span class="text-2xl font-bold text-blue-700">${product.price}</span>
                            </div>

                            <div class="mb-8">
                                <h3 class="text-xl font-bold mb-4">Description</h3>
                                <div class="bg-white rounded-xl shadow-sm p-6">
                                    <p class="text-gray-700 mb-4">${product.short}</p>
                                    <p class="text-gray-700 leading-relaxed">${product.description}</p>
                                </div>
                            </div>

                            ${product.specifications ? `
                            <div class="mb-8">
                                <h3 class="text-xl font-bold mb-4">Specifications</h3>
                                <div class="bg-white rounded-xl shadow-sm p-6">
                                    ${Object.entries(product.specifications).map(([key, value]) => `
                                        <div class="flex justify-between py-3 border-b border-gray-100">
                                            <span class="text-gray-600">${key}</span>
                                            <span class="font-semibold">${value}</span>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                            ` : ''}

                            <div class="flex gap-4">
                                <a href="catalog" 
                                   class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-3 px-6 rounded-lg text-center transition">
                                    <i class="fas fa-arrow-left mr-2"></i> Back to Catalog
                                </a>
                                <a href="https://wa.me/447895047944?text=I'm interested in ${encodeURIComponent(product.name)}" 
                                   target="_blank"
                                   class="flex-1 bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg text-center transition">
                                    <i class="fab fa-whatsapp mr-2"></i> WhatsApp Inquiry
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <footer class="bg-gray-800 text-white py-8 mt-12">
                    <div class="max-w-7xl mx-auto px-4 text-center">
                        <p>© 2025 V5 Medical LTD. All rights reserved.</p>
                    </div>
                </footer>
            `;
        }

        // 页面加载时执行
        document.addEventListener('DOMContentLoaded', () => {
            const productId = getProductId();
            console.log('Product ID from URL:', productId);
            
            if (!productId) {
                renderProduct(null);
                return;
            }
            
            const product = PRODUCTS[productId];
            console.log('Found product:', product);
            
            if (product) {
                renderProduct(product);
            } else {
                // 尝试查找相近的产品
                const foundProduct = Object.values(PRODUCTS).find(p => 
                    p.id.includes(productId) || productId.includes(p.id)
                );
                
                if (foundProduct) {
                    console.log('Found similar product:', foundProduct);
                    renderProduct(foundProduct);
                } else {
                    console.log('No product found for ID:', productId);
                    console.log('Available IDs:', Object.keys(PRODUCTS));
                    renderProduct(null);
                }
            }
        });
    </script>
