# ------------------------------
# V5 Medical LTD Headers Configuration
# Optimized for Cloudflare Pages, Docsify & Stripe
# ------------------------------

# ------------------------------
# GLOBAL SECURITY HEADERS
# ------------------------------
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  # 已开放 payment 权限，为未来嵌入 Stripe 支付组件做准备
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://js.stripe.com"), usb=(), accelerometer=(), gyroscope=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # CSP 优化：
  # 1. 增加了 https://*.stripe.com 以支持支付链接嵌入
  # 2. 增加了 data: 协议以支持 Base64 图片和字体
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://www.google.com https://www.gstatic.com https://unpkg.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://fonts.googleapis.com; img-src 'self' data: https://*.stripe.com https://pub-224e4e74685e409e833e89d4ab5143fb.r2.dev; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' https://api.whatsapp.com https://formspree.io https://www.google-analytics.com https://raw.githubusercontent.com https://api.stripe.com; frame-src 'self' https://www.google.com https://www.youtube.com https://*.stripe.com https://js.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; upgrade-insecure-requests

  X-Permitted-Cross-Domain-Policies: none
  X-Download-Options: noopen
  Expect-CT: max-age=86400, enforce

# ------------------------------
# DOCSIFY & MARKDOWN CONFIG
# Ensures .md files are rendered correctly as raw text for Docsify to parse
